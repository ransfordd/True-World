# =============================================================================
# Coolify / Docker: set these as runtime environment variables (not baked into
# the image). Forms will fall back to mailto: until SMTP_* is fully configured.
# =============================================================================

# SMTP (required for in-app email delivery — Nodemailer)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Inbox that receives form submissions (contact, prayer, coaching, subscribe)
MAIL_TO=info@thetrueword.com

# From address used by Nodemailer
MAIL_FROM="The True Word <noreply@thetrueword.com>"

# Used by client-side mailto: fallback when the API cannot send mail
NEXT_PUBLIC_MAIL_TO=info@thetrueword.com

# -----------------------------------------------------------------------------
# Self-hosted CMS (/admin) — file store + JWT sessions
# -----------------------------------------------------------------------------

# Long random string (32+ chars). Used to sign staff login cookies.
CMS_SECRET=change-me-to-a-long-random-secret

# Session cookie Secure flag. Browsers reject Secure cookies on plain HTTP.
# - Leave unset: secure=true in production (use HTTPS)
# - Coolify HTTP / sslip (no TLS yet): CMS_COOKIE_SECURE=false
# - After enabling HTTPS: CMS_COOKIE_SECURE=true (or remove this line)
# CMS_COOKIE_SECURE=false

# Optional alias (same purpose as CMS_SECRET)
# PAYLOAD_SECRET=

# First admin account (created on first boot if missing)
CMS_ADMIN_EMAIL=admin@thetrueword.com
CMS_ADMIN_PASSWORD=ChangeMe123!

# Where store.json is written (default: ./data/cms). Docker/compose set this for you.
# CMS_DATA_DIR=/app/data/cms
