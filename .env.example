# =============================================================================
# Coolify / Docker: set these as runtime environment variables (not baked into
# the image). Forms will fall back to mailto: until SMTP_* is fully configured.
# =============================================================================

# SMTP (required for in-app email delivery — Nodemailer)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Inbox that receives form submissions (contact, prayer, coaching, subscribe)
MAIL_TO=info@thetrueword.com

# From address used by Nodemailer
MAIL_FROM="The True Word <noreply@thetrueword.com>"

# Used by client-side mailto: fallback when the API cannot send mail
NEXT_PUBLIC_MAIL_TO=info@thetrueword.com
