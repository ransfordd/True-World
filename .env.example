# SMTP (required for real email delivery)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Inbox that receives form submissions
MAIL_TO=info@thetrueword.com

# From address used by Nodemailer
MAIL_FROM="The True Word <noreply@thetrueword.com>"

# Used by client-side mailto fallback
NEXT_PUBLIC_MAIL_TO=info@thetrueword.com
